generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  STAFF

  @@map("role")
}

enum Unit {
  KG
  G
  L
  ML
  PIECE

  @@map("unit")
}

enum TransactionType {
  IN
  OUT
  ADJUSTMENT

  @@map("transaction_type")
}

enum TransactionReference {
  ORDER
  MANUAL
  RESTOCK

  @@map("transaction_reference")
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED

  @@map("order_status")
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY

  @@map("order_type")
}

enum PaymentMethod {
  CASH
  CARD
  WALLET

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("payment_status")
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid()) @db.Uuid
  firstName String   @map("first_name") @db.VarChar(255)
  lastName  String   @map("last_name") @db.VarChar(255)
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]
  cart   Cart?

  @@map("users")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  menuItems MenuItem[]

  @@map("category_item")
}

model MenuItem {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String
  price       Decimal  @db.Decimal(10, 2)
  description String
  image       String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category        Category             @relation(fields: [categoryId], references: [id])
  cartItems       CartItem[]
  orderItems      OrderItem[]
  menuIngredients MenuItemIngredient[]

  @@index([categoryId])
  @@map("items")
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@map("cart")
}

model CartItem {
  id         String @id @default(uuid()) @db.Uuid
  cartId     String @map("cart_id") @db.Uuid
  menuItemId String @map("menu_item_id") @db.Uuid
  quantity   Int

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([menuItemId])
  @@map("cart_items")
}

model Ingredient {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  unit            Unit
  quantity        Int
  minimumQuantity Int      @map("minimum_quantity")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  transactions    InventoryTransaction[]
  menuIngredients MenuItemIngredient[]

  @@map("ingredients")
}

model InventoryTransaction {
  id           String               @id @default(uuid()) @db.Uuid
  ingredientId String               @map("ingredient_id") @db.Uuid
  type         TransactionType
  quantity     Int
  reference    TransactionReference
  createdAt    DateTime             @default(now()) @map("created_at")

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  orderId    String?    @map("order_id") @db.Uuid
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([ingredientId])
  @@index([orderId])
  @@map("inventory_transactions")
}

model MenuItemIngredient {
  id               String @id @default(uuid()) @db.Uuid
  menuItemId       String @map("menu_item_id") @db.Uuid
  ingredientId     String @map("ingredient_id") @db.Uuid
  quantityRequired Int    @map("quantity_required")

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
  @@index([menuItemId])
  @@index([ingredientId])
  @@map("menu_item_ingredients")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  status      OrderStatus @default(PENDING)
  orderType   OrderType   @map("order_type")
  totalAmount Decimal     @map("total_amount") @db.Decimal(10, 2)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  items                 OrderItem[]
  payment               Payment?
  inventoryTransactions InventoryTransaction[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String  @map("order_id") @db.Uuid
  menuItemId String  @map("menu_item_id") @db.Uuid
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  orderId              String        @unique @map("order_id") @db.Uuid
  amount               Decimal       @db.Decimal(10, 2)
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  transactionReference String        @map("transaction_reference")
  paidAt               DateTime?     @map("paid_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("payments")
}
